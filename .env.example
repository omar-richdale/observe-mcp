# Only needed if you prefer a file over `npm run setup`.
# Point the server at it with O2_ENV_FILE=/path/to/this/file — it is not read
# automatically, so a stray copy can never silently override your real config.
#
# Copy to .env (git-ignored) and fill in.

O2_URL=https://o2.example.com
O2_ORG=default
O2_USER=you@example.com
O2_TOKEN=

# Optional: a READ-ONLY Postgres role. Verify it with `npm run doctor` —
# a role named "read only" is not necessarily read-only.
O2_DB_URL=

# Optional: noise sources to filter out of counts (monitors, CI, your crawlers).
O2_EXCLUDE_IPS=

# Optional: anything about your data worth telling the assistant up front.
O2_EXTRA_NOTES=

# Optional: statement timeout for database queries, milliseconds.
O2_DB_TIMEOUT_MS=15000
